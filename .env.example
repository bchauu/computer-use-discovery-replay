# Copy to .env. This file contains only local development defaults.
# The automation database stores sanitized runs and capability artifacts.
AUTOMATION_MONGODB_URI=mongodb://127.0.0.1:27018/automation_dev
# Required only for the persisted operator run inspector. Use a long random value.
OPERATOR_ACCESS_TOKEN=replace-with-a-random-local-token
# Optional infrastructure-only health check. The synthetic bank UI itself uses bundled fixtures.
# BANK_MONGODB_URI=mongodb://127.0.0.1:27018/bank_demo_dev

# Optional until the discovery sprint. Never prefix secrets with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Use only for explicitly injected local wiring runs. Never present mock output as genuine discovery evidence.
DISCOVERY_MODEL_MODE=openai

# Discovery defaults are deliberately generous for the first live experiment.
DISCOVERY_MAX_STEPS=40
DISCOVERY_RUN_TIMEOUT_MS=600000
DISCOVERY_MODEL_TIMEOUT_MS=120000
DISCOVERY_ACTION_TIMEOUT_MS=30000
DISCOVERY_MODEL_ATTEMPTS=3
DISCOVERY_RETRY_BASE_MS=1000
DISCOVERY_REPEAT_LIMIT=3
DISCOVERY_NO_PROGRESS_LIMIT=3
DISCOVERY_MAX_MODEL_CALLS=50
DISCOVERY_MAX_TOTAL_TOKENS=100000
DISCOVERY_HEADLESS=false
BANK_TARGET_URL=http://127.0.0.1:5174/#/members

# Fixed local service ports: automation API 3001, bank API 3002.
# Vite frontends: operator 5173, bank demo 5174.
